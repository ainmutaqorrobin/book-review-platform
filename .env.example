# Compose Project
COMPOSE_PROJECT_NAME=book-review-platform

# Service Ports
BACKEND_PORT=4000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# PostgreSQL
POSTGRES_USER=bookreview
POSTGRES_PASSWORD=bookreviewpassword
POSTGRES_DB=bookreview
DATABASE_URL=postgresql://bookreview:bookreviewpassword@localhost:5432/bookreview

# Redis
REDIS_URL=redis://localhost:6379

# Backend Runtime
PORT=4000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://book-review.mutaqorrobin.online
LOG_LEVEL=info
LOG_PRETTY=false

# AI Providers
OPENAI_API_KEY=your_openai_secret_key
ANTHROPIC_API_KEY=your_anthropic_secret_key

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=86400000

# Rate Limiting
GLOBAL_RATE_LIMIT_MAX=100
REVIEW_RATE_LIMIT_WINDOW_MS=900000
REVIEW_RATE_LIMIT_MAX=300

# AI Review Enrichment Worker
AI_ENRICHMENT_CONCURRENCY=2
AI_ENRICHMENT_SIMULATED_DELAY_MS=0

# Admin Seed
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_NAME=Platform Admin
ADMIN_SEED_PASSWORD=admin12345

# S3-Compatible Storage
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=book-review
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
